PORT=3000
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*

# ---- Database: "mysql" (local) or "postgres" (Supabase / RDS) ----
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=txn_webhooks
DB_SSL=false
# For Supabase use the "Session pooler" connection string instead of the fields above:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SSL=true
DB_SYNC=true

# ---- Background processing ----
PROCESSING_DELAY_MS=30000
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=120000
WORKER_MAX_CONCURRENT=100
WORKER_MAX_ATTEMPTS=5
SIMULATED_FAILURE_RATE=0
WEBHOOK_PERSIST_TIMEOUT_MS=400
