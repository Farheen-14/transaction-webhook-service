# =============================================================================
# Transaction Webhook Service: environment configuration
#
# Copy this file to `.env` and fill in your values:   cp .env.example .env
# `.env` is git-ignored, so passwords never end up in the repository.
# Every variable is optional; the value shown here is the default.
# =============================================================================

# ---- Server -----------------------------------------------------------------

# Port the HTTP API listens on.
PORT=3000

# Browser origins allowed to call the API (CORS). "*" allows any origin.
# In production, list the dashboard URL(s), comma-separated, e.g.
# CORS_ORIGIN=https://dashboard.example.com,http://localhost:5173
CORS_ORIGIN=*

# ---- Database ---------------------------------------------------------------

# Which database to use: "mysql" (local / EC2) or "postgres" (Supabase / RDS).
DB_TYPE=mysql

# Connection details (ignored when DATABASE_URL is set).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# For MySQL this database is created automatically if it does not exist.
DB_NAME=txn_webhooks

# Full connection string. Takes priority over the fields above.
# For Supabase use Connect -> "Session pooler" (IPv4) and set DB_TYPE=postgres, DB_SSL=true:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Use TLS for the database connection. Required for Supabase / RDS.
DB_SSL=false

# Create/update tables automatically from the entity on startup.
# Fine for this assignment; use migrations instead for a real production system.
DB_SYNC=true

# ---- Webhook endpoint ---------------------------------------------------------

# Max time (ms) to wait for the database when storing a webhook. Slower than this -> 503,
# and the processor retries. Keeps the endpoint inside its 500ms response budget.
WEBHOOK_PERSIST_TIMEOUT_MS=400

# ---- Background processing ----------------------------------------------------

# Simulated external API call per transaction (spec: 30 seconds).
PROCESSING_DELAY_MS=30000

# How often (ms) the worker looks for new transactions.
WORKER_POLL_INTERVAL_MS=1000

# How long (ms) a worker owns a claimed transaction. MUST be greater than PROCESSING_DELAY_MS.
# If the server crashes, the transaction is picked up again once this lease expires.
WORKER_LEASE_MS=120000

# Max transactions processed in parallel by one server.
WORKER_MAX_CONCURRENT=100

# Attempts before a transaction is marked FAILED (retries back off 5s, 10s, 20s, ...).
WORKER_MAX_ATTEMPTS=5

# Testing only: chance (0..1) that the simulated external call fails, to demo retries.
SIMULATED_FAILURE_RATE=0
